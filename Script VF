"""
Calcul optimisé d'itinéraires Vélib avec Dijkstra
AMÉLIORATIONS :
- Checkpoint pour reprendre en cas d'interruption
- Calcul parallèle sur plusieurs CPU
- Monitoring de progression et RAM
- Filtrage des paires peu fréquentes (optionnel)
"""

import json
import osmnx as ox
import networkx as nx
import geopandas as gpd
from shapely.geometry import LineString
from collections import defaultdict
from tqdm import tqdm
import pickle
import os
from multiprocessing import Pool, cpu_count
import psutil

# Configuration des chemins
base_dir = "/Users/titou/Documents/Tradd 22/MCDNU/Fichiers"
stations_file = f"{base_dir}/velib-emplacement-des-stations.json"
trajets_file = f"{base_dir}/bike_stats_allege.json"
output_routes = f"{base_dir}/velib_routes_optimized.geojson"
output_segments = f"{base_dir}/velib_segments_optimized.geojson"
checkpoint_file = f"{base_dir}/routes_checkpoint.pkl"

# Paramètres d'optimisation
MIN_TRIP_COUNT = 1  # Augmente à 3-5 pour ignorer les trajets rares et accélérer
USE_PARALLEL = True  # Calcul parallèle sur plusieurs CPU
NUM_WORKERS = min(4, cpu_count() - 1)  # Nombre de CPU à utiliser

# ============================================================================
# MONITORING
# ============================================================================

def print_memory_usage():
    mem = psutil.virtual_memory()
    print(f"💾 RAM : {mem.used/1e9:.1f}/{mem.total/1e9:.1f} GB ({mem.percent}%)")

# ============================================================================
# ÉTAPE 1 : Chargement et harmonisation des données
# ============================================================================

def load_and_harmonize_data(stations_file, trajets_file):
    """Charge et harmonise les identifiants des stations"""
    print("📥 Chargement des données...")
    print_memory_usage()
    
    with open(stations_file, 'r', encoding='utf-8') as f:
        stations_data = json.load(f)
    
    with open(trajets_file, 'r', encoding='utf-8') as f:
        trajets_data = json.load(f)
    
    # Harmoniser les identifiants (retirer 'station_')
    for bike in trajets_data:
        for stat in bike['stats']:
            if stat.get('start_station_id'):
                stat['start_station_id'] = stat['start_station_id'].replace('station_', '')
            if stat.get('end_station_id'):
                stat['end_station_id'] = stat['end_station_id'].replace('station_', '')
    
    print_memory_usage()
    return stations_data, trajets_data

stations_data, trajets_data = load_and_harmonize_data(stations_file, trajets_file)

# ============================================================================
# ÉTAPE 2 : Extraction des coordonnées des stations
# ============================================================================

stations_coords = {}
for s in stations_data:
    code = s.get("stationcode")
    coords = s.get("coordonnees_geo", {})
    lon = coords.get("lon")
    lat = coords.get("lat")
    if code and lon is not None and lat is not None:
        stations_coords[str(code)] = (lon, lat)

print(f"✅ {len(stations_coords)} stations chargées")

# ============================================================================
# ÉTAPE 3 : Extraction des paires uniques et comptage
# ============================================================================

print("🔍 Analyse des trajets...")
pair_counts = defaultdict(int)

for bike in trajets_data:
    for stat in bike.get('stats', []):
        if stat.get('status') == 'completed' and stat.get('end_station_id'):
            start = stat.get('start_station_id')
            end = stat.get('end_station_id')
            
            if start in stations_coords and end in stations_coords and start != end:
                pair_counts[(start, end)] += 1

# Filtrer les paires peu fréquentes (optionnel)
pair_counts = {k: v for k, v in pair_counts.items() if v >= MIN_TRIP_COUNT}

unique_pairs = list(pair_counts.keys())
print(f"✅ {len(unique_pairs)} paires uniques (≥{MIN_TRIP_COUNT} trajets)")
print(f"📊 {sum(pair_counts.values())} trajets totaux")
print(f"⏱️  Temps estimé : {len(unique_pairs) * 0.3 / 60:.0f}-{len(unique_pairs) * 0.5 / 60:.0f} minutes")

# Libérer la mémoire
del trajets_data
print_memory_usage()

# ============================================================================
# ÉTAPE 4 : Téléchargement du graphe routier
# ============================================================================

place = [
    "Paris, France",
    "Val-de-marne, France",
    "Seine-Saint-Denis, France",
    "Hauts-de-Seine, France",
    "Argenteuil, France",
    "Houilles, France",
    "Carrières-sur-Seine, France",
    "Bezons, France"
]

print("🗺️  Téléchargement du graphe OSM...")
G = ox.graph_from_place(place, network_type="bike")
print(f"✅ Graphe téléchargé : {len(G.nodes)} nœuds - {len(G.edges)} arêtes")
print_memory_usage()

# ============================================================================
# ÉTAPE 5 : Calcul des itinéraires avec checkpoint
# ============================================================================

def calculate_single_route(args):
    """Calcule un seul itinéraire (pour parallélisation)"""
    start_code, end_code, count, G_copy, stations_coords_copy = args
    
    start_coords = stations_coords_copy[start_code]
    end_coords = stations_coords_copy[end_code]
    
    try:
        orig_node = ox.distance.nearest_nodes(G_copy, start_coords[0], start_coords[1])
        dest_node = ox.distance.nearest_nodes(G_copy, end_coords[0], end_coords[1])
        
        path = nx.shortest_path(G_copy, orig_node, dest_node, weight="length")
        points = [(G_copy.nodes[n]["x"], G_copy.nodes[n]["y"]) for n in path]
        line = LineString(points)
        length = nx.shortest_path_length(G_copy, orig_node, dest_node, weight="length")
        
        return {
            "geometry": line,
            "start_station": start_code,
            "end_station": end_code,
            "trip_count": count,
            "length": length
        }
    except:
        return None

# Vérifier s'il y a un checkpoint
if os.path.exists(checkpoint_file):
    print("📂 Checkpoint trouvé, chargement...")
    with open(checkpoint_file, 'rb') as f:
        routes = pickle.load(f)
    print(f"✅ {len(routes)} itinéraires déjà calculés")
else:
    routes = []

# Calculer les routes manquantes
already_computed = {(r['start_station'], r['end_station']) for r in routes}
remaining_pairs = [(s, e, pair_counts[(s, e)]) for s, e in unique_pairs 
                   if (s, e) not in already_computed]

print(f"🚴 Calcul de {len(remaining_pairs)} itinéraires restants...")

if USE_PARALLEL and len(remaining_pairs) > 100:
    print(f"🔄 Calcul parallèle sur {NUM_WORKERS} CPU")
    # Préparer les arguments
    args_list = [(s, e, c, G, stations_coords) for s, e, c in remaining_pairs]
    
    # Calcul parallèle avec barre de progression
    with Pool(NUM_WORKERS) as pool:
        results = list(tqdm(
            pool.imap(calculate_single_route, args_list),
            total=len(args_list),
            desc="Calcul itinéraires"
        ))
    
    # Filtrer les None
    new_routes = [r for r in results if r is not None]
    routes.extend(new_routes)
    
else:
    # Calcul séquentiel
    for start_code, end_code, count in tqdm(remaining_pairs, desc="Calcul itinéraires"):
        result = calculate_single_route((start_code, end_code, count, G, stations_coords))
        if result:
            routes.append(result)
        
        # Sauvegarder un checkpoint tous les 1000 itinéraires
        if len(routes) % 1000 == 0:
            with open(checkpoint_file, 'wb') as f:
                pickle.dump(routes, f)

# Sauvegarder le checkpoint final
with open(checkpoint_file, 'wb') as f:
    pickle.dump(routes, f)

failed_count = len(unique_pairs) - len(routes)
print(f"✅ {len(routes)} itinéraires calculés")
if failed_count > 0:
    print(f"⚠️  {failed_count} paires échouées ({failed_count/len(unique_pairs)*100:.1f}%)")

# ============================================================================
# ÉTAPE 6 : Sauvegarde des itinéraires
# ============================================================================

print("💾 Sauvegarde des itinéraires...")
gdf_routes = gpd.GeoDataFrame(routes, crs="EPSG:4326")
gdf_routes.to_file(output_routes, driver="GeoJSON")
print(f"✅ Fichier sauvegardé : {output_routes}")

# Supprimer le checkpoint après succès
if os.path.exists(checkpoint_file):
    os.remove(checkpoint_file)

# ============================================================================
# ÉTAPE 7 : Calcul des segments de rue avec comptage
# ============================================================================

print("🛣️  Calcul des segments de rue...")
segment_counts = defaultdict(int)

for route in tqdm(routes, desc="Agrégation segments"):
    line = route["geometry"]
    trip_count = route["trip_count"]
    
    for i in range(len(line.coords) - 1):
        segment = (line.coords[i], line.coords[i + 1])
        segment_counts[segment] += trip_count

print(f"✅ {len(segment_counts)} segments uniques identifiés")

# ============================================================================
# ÉTAPE 8 : Sauvegarde des segments
# ============================================================================

print("💾 Sauvegarde des segments...")
segments = []
for segment, count in segment_counts.items():
    start, end = segment
    line = LineString([start, end])
    segments.append({
        "geometry": line,
        "passage_count": count
    })

gdf_segments = gpd.GeoDataFrame(segments, crs="EPSG:4326")
gdf_segments.to_file(output_segments, driver="GeoJSON")
print(f"✅ Fichier sauvegardé : {output_segments}")

# ============================================================================
# STATISTIQUES FINALES
# ============================================================================

print("\n" + "="*60)
print("📊 STATISTIQUES FINALES")
print("="*60)
print(f"Paires uniques calculées : {len(routes):,}")
print(f"Trajets totaux affectés  : {sum(r['trip_count'] for r in routes):,}")
print(f"Segments de rue          : {len(segments):,}")
print(f"Passage max sur 1 segment: {max(segment_counts.values()):,}")
print(f"Passage moyen/segment    : {sum(segment_counts.values()) / len(segment_counts):.1f}")
print("="*60)
print_memory_usage()
