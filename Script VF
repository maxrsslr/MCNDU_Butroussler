"""
Script HYBRIDE - SANS PARALLÉLISATION (compatible Spyder/Mac)
✅ Checkpoint
✅ Cache graphe OSM
✅ Pré-calcul nœuds
✅ Mode DEBUG
✅ Monitoring RAM
❌ Pas de parallélisation (pour éviter les problèmes Mac/Spyder)
"""

import json
import osmnx as ox
import networkx as nx
import geopandas as gpd
from shapely.geometry import LineString
from collections import defaultdict
from tqdm import tqdm
import pickle
import os
import psutil

# ============================================================================
# CONFIGURATION
# ============================================================================

base_dir = "/Users/titou/Documents/Tradd 22/MCDNU/Fichiers"
stations_file = f"{base_dir}/velib-emplacement-des-stations.json"
trajets_file = f"{base_dir}/bike_stats_allege.json"
output_routes = f"{base_dir}/velib_routes_optimized.geojson"
output_segments = f"{base_dir}/velib_segments_optimized.geojson"
checkpoint_file = f"{base_dir}/routes_checkpoint.pkl"
graph_cache_file = f"{base_dir}/graph_cache.pkl"
nodes_cache_file = f"{base_dir}/station_nodes_cache.pkl"

# Paramètres
MIN_TRIP_COUNT = 1
DEBUG_MODE = False  # Mettre True pour tester avec 1000 trajets
DEBUG_SAMPLE_SIZE = 1000

print("="*60)
print("CALCUL ITINÉRAIRES VÉLIB - VERSION SÉQUENTIELLE")
print("="*60)

# ============================================================================
# MONITORING
# ============================================================================

def print_memory_usage():
    mem = psutil.virtual_memory()
    print(f"💾 RAM : {mem.used/1e9:.1f}/{mem.total/1e9:.1f} GB ({mem.percent:.1f}%)")

#%%
# ============================================================================
# ÉTAPE 1 : Chargement des données
# ============================================================================

print("\n[1/8] Chargement des données...")
print_memory_usage()

with open(stations_file, 'r', encoding='utf-8') as f:
    stations_data = json.load(f)

with open(trajets_file, 'r', encoding='utf-8') as f:
    trajets_data = json.load(f)

# Harmoniser les IDs
for bike in trajets_data:
    for stat in bike['stats']:
        if stat.get('start_station_id'):
            stat['start_station_id'] = stat['start_station_id'].replace('station_', '')
        if stat.get('end_station_id'):
            stat['end_station_id'] = stat['end_station_id'].replace('station_', '')

print_memory_usage()

#%%
# ============================================================================
# ÉTAPE 2 : Extraction coordonnées stations
# ============================================================================

print("\n[2/8] Extraction des coordonnées des stations...")

stations_coords = {}
for s in stations_data:
    code = str(s.get("stationcode"))
    coords = s.get("coordonnees_geo", {})
    lon, lat = coords.get("lon"), coords.get("lat")
    if code and lon is not None and lat is not None:
        stations_coords[code] = (lon, lat)

print(f"✅ {len(stations_coords)} stations chargées")

#%%
# ============================================================================
# ÉTAPE 3 : Extraction paires uniques
# ============================================================================

print("\n[3/8] Analyse des trajets...")

pair_counts = defaultdict(int)
for bike in trajets_data:
    for stat in bike.get('stats', []):
        if stat.get('status') == 'completed' and stat.get('end_station_id'):
            start = stat.get('start_station_id')
            end = stat.get('end_station_id')
            
            if start in stations_coords and end in stations_coords and start != end:
                pair_counts[(start, end)] += 1

# Mode DEBUG
if DEBUG_MODE:
    print(f"⚠️  MODE DEBUG : échantillonnage de {DEBUG_SAMPLE_SIZE} paires")
    import random
    all_pairs = list(pair_counts.items())
    random.shuffle(all_pairs)
    pair_counts = dict(all_pairs[:DEBUG_SAMPLE_SIZE])

pair_counts = {k: v for k, v in pair_counts.items() if v >= MIN_TRIP_COUNT}
unique_pairs = list(pair_counts.keys())

print(f"✅ {len(unique_pairs)} paires uniques (≥{MIN_TRIP_COUNT} trajets)")
print(f"📊 {sum(pair_counts.values())} trajets totaux")
print(f"⏱️  Temps estimé (séquentiel) : {len(unique_pairs) * 0.3 / 60:.0f}-{len(unique_pairs) * 0.5 / 60:.0f} minutes")

# Libérer mémoire
del trajets_data
print_memory_usage()

#%%
# ============================================================================
# ÉTAPE 4 : Chargement/Téléchargement graphe OSM (AVEC CACHE)
# ============================================================================

print("\n[4/8] Chargement du graphe routier...")

place = [
    "Paris, France",
    "Val-de-marne, France",
    "Seine-Saint-Denis, France",
    "Hauts-de-Seine, France",
    "Argenteuil, France",
    "Houilles, France",
    "Carrières-sur-Seine, France",
    "Bezons, France"
]

if os.path.exists(graph_cache_file):
    print("  → Chargement depuis le cache...")
    with open(graph_cache_file, 'rb') as f:
        G = pickle.load(f)
    print(f"✅ Graphe chargé : {len(G.nodes):,} nœuds, {len(G.edges):,} arêtes")
else:
    print("  → Téléchargement depuis OpenStreetMap (2-5 min)...")
    G = ox.graph_from_place(place, network_type="bike")
    print(f"  → Graphe téléchargé : {len(G.nodes):,} nœuds, {len(G.edges):,} arêtes")
    
    print("  → Extraction du composant principal...")
    G = ox.truncate.largest_component(G, strongly=True)
    print(f"  → Graphe traité : {len(G.nodes):,} nœuds, {len(G.edges):,} arêtes")
    
    print("  → Sauvegarde du cache...")
    with open(graph_cache_file, 'wb') as f:
        pickle.dump(G, f)
    print(f"✅ Cache sauvegardé : {graph_cache_file}")

print_memory_usage()

#%%
# ============================================================================
# ÉTAPE 5 : Pré-calcul des nœuds OSM (AVEC CACHE)
# ============================================================================

print("\n[5/8] Pré-calcul des nœuds OSM pour chaque station...")

if os.path.exists(nodes_cache_file):
    print("  → Chargement depuis le cache...")
    with open(nodes_cache_file, 'rb') as f:
        station_nodes = pickle.load(f)
    print(f"✅ {len(station_nodes)} nœuds chargés")
else:
    station_nodes = {}
    for code, coords in tqdm(stations_coords.items(), desc="Calcul nœuds"):
        try:
            station_nodes[code] = ox.distance.nearest_nodes(G, coords[0], coords[1])
        except Exception as e:
            print(f"  ⚠️  Station {code} : {e}")
    
    with open(nodes_cache_file, 'wb') as f:
        pickle.dump(station_nodes, f)
    print(f"✅ {len(station_nodes)} nœuds calculés et sauvegardés")

#%%
# ============================================================================
# ÉTAPE 6 : Calcul itinéraires SÉQUENTIEL avec checkpoint
# ============================================================================

print("\n[6/8] Calcul des itinéraires (mode séquentiel)...")

def calculate_single_route(start_code, end_code, count):
    """Calcule un seul itinéraire"""
    if start_code not in station_nodes or end_code not in station_nodes:
        return None
    
    try:
        orig_node = station_nodes[start_code]
        dest_node = station_nodes[end_code]
        
        path = nx.shortest_path(G, orig_node, dest_node, weight="length")
        points = [(G.nodes[n]["x"], G.nodes[n]["y"]) for n in path]
        line = LineString(points)
        length = nx.shortest_path_length(G, orig_node, dest_node, weight="length")
        
        return {
            "geometry": line,
            "start_station": start_code,
            "end_station": end_code,
            "trip_count": count,
            "length": length
        }
    except:
        return None

# Charger checkpoint si existe
if os.path.exists(checkpoint_file):
    print("📂 Checkpoint trouvé, chargement...")
    with open(checkpoint_file, 'rb') as f:
        routes = pickle.load(f)
    print(f"✅ {len(routes)} itinéraires déjà calculés")
else:
    routes = []

# Calculer les routes manquantes
already_computed = {(r['start_station'], r['end_station']) for r in routes}
remaining_pairs = [(s, e, pair_counts[(s, e)]) for s, e in unique_pairs 
                   if (s, e) not in already_computed]

print(f"🚴 Calcul de {len(remaining_pairs)} itinéraires restants...")

# Calcul séquentiel avec checkpoints réguliers
for i, (start_code, end_code, count) in enumerate(tqdm(remaining_pairs, desc="Calcul itinéraires")):
    result = calculate_single_route(start_code, end_code, count)
    if result:
        routes.append(result)
    
    # Sauvegarder un checkpoint tous les 500 itinéraires
    if (i + 1) % 500 == 0:
        with open(checkpoint_file, 'wb') as f:
            pickle.dump(routes, f)
        print(f"  💾 Checkpoint: {len(routes)} routes calculées")

# Sauvegarder le checkpoint final
with open(checkpoint_file, 'wb') as f:
    pickle.dump(routes, f)

failed_count = len(unique_pairs) - len(routes)
print(f"✅ {len(routes)} itinéraires calculés")
if failed_count > 0:
    print(f"⚠️  {failed_count} paires échouées ({failed_count/len(unique_pairs)*100:.1f}%)")

#%%
# ============================================================================
# ÉTAPE 7 : Sauvegarde itinéraires
# ============================================================================

print("\n[7/8] Sauvegarde des itinéraires...")
gdf_routes = gpd.GeoDataFrame(routes, crs="EPSG:4326")
gdf_routes.to_file(output_routes, driver="GeoJSON")
print(f"✅ Fichier sauvegardé : {output_routes}")

# Supprimer le checkpoint après succès
if os.path.exists(checkpoint_file):
    os.remove(checkpoint_file)
    print("✅ Checkpoint supprimé (succès)")

#%%
# ============================================================================
# ÉTAPE 8 : Calcul segments
# ============================================================================

print("\n[8/8] Calcul des segments de rue...")
segment_counts = defaultdict(int)

for route in tqdm(routes, desc="Agrégation segments"):
    line = route["geometry"]
    trip_count = route["trip_count"]
    
    for i in range(len(line.coords) - 1):
        segment = (line.coords[i], line.coords[i + 1])
        segment_counts[segment] += trip_count

print(f"✅ {len(segment_counts)} segments uniques identifiés")

print("💾 Sauvegarde des segments...")
segments = []
for segment, count in segment_counts.items():
    start, end = segment
    line = LineString([start, end])
    segments.append({
        "geometry": line,
        "passage_count": count
    })

gdf_segments = gpd.GeoDataFrame(segments, crs="EPSG:4326")
gdf_segments.to_file(output_segments, driver="GeoJSON")
print(f"✅ Fichier sauvegardé : {output_segments}")

#%%
# ============================================================================
# STATISTIQUES FINALES
# ============================================================================

print("\n" + "="*60)
print("📊 STATISTIQUES FINALES")
print("="*60)
print(f"Paires uniques calculées : {len(routes):,}")
print(f"Trajets totaux affectés  : {sum(r['trip_count'] for r in routes):,}")
print(f"Segments de rue          : {len(segments):,}")
if segment_counts:
    print(f"Passage max sur 1 segment: {max(segment_counts.values()):,}")
    print(f"Passage moyen/segment    : {sum(segment_counts.values()) / len(segment_counts):.1f}")
print("="*60)
print_memory_usage()

print("\n🎉 TERMINÉ ! Fichiers générés :")
print(f"  • {output_routes}")
print(f"  • {output_segments}")
