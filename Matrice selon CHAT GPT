# pip install osmnx networkx geopandas pandas pyarrow tqdm

import json
import numpy as np
import pandas as pd
import geopandas as gpd
import osmnx as ox
import networkx as nx
from tqdm import tqdm

# ----------------------------
# Entrées / sorties
# ----------------------------
IN_JSON = "velib-disponibilite-en-temps-reel.json"
OUT_OD = "od_bike_all_pairs.parquet"
OUT_STATIONS = "stations_with_nodes.parquet"

# ----------------------------
# 1) Charger stations (toutes)
# ----------------------------
with open(IN_JSON, "r", encoding="utf-8") as f:
    data = json.load(f)

df = pd.json_normalize(data)

stations = df[
    df["coordonnees_geo.lon"].notna() &
    df["coordonnees_geo.lat"].notna()
].copy()

stations = stations.rename(columns={
    "stationcode": "station_id",
    "name": "station_name",
    "coordonnees_geo.lon": "lon",
    "coordonnees_geo.lat": "lat",
})
stations = stations[["station_id", "station_name", "lon", "lat"]].drop_duplicates()

# ----------------------------
# 2) Télécharger EXACTEMENT le périmètre demandé (union de polygones)
# ----------------------------
PLACES = [
    "Paris, France",
    "Hauts-de-Seine, France",
    "Seine-Saint-Denis, France",
    "Val-de-Marne, France",
    "Chatou, France",
    "Houilles, France",
    "Carrières-sur-Seine, France",
    "Sartrouville, France",
    "Argenteuil, France",
]

ox.settings.use_cache = True
ox.settings.log_console = True

gdfs = [ox.geocode_to_gdf(p) for p in PLACES]
zone_gdf = gpd.GeoDataFrame(pd.concat(gdfs, ignore_index=True), crs=gdfs[0].crs)

# Union géométrique = périmètre final
zone_polygon = zone_gdf.unary_union

# ----------------------------
# 3) Graphe vélo sur ce périmètre
# ----------------------------
G = ox.graph_from_polygon(zone_polygon, network_type="bike", simplify=True)
G = ox.add_edge_lengths(G)  # distance en mètres dans l'attribut "length"

# ----------------------------
# 4) Snap stations -> noeuds du graphe
# ----------------------------
stations["node"] = ox.distance.nearest_nodes(G, X=stations["lon"].values, Y=stations["lat"].values)

stations.to_parquet(OUT_STATIONS, index=False)

# ----------------------------
# 5) Matrice OD (all pairs) via Dijkstra (1 origine -> toutes destinations)
#    (optimisation: on calcule par node unique puis on remappe)
# ----------------------------
station_ids = stations["station_id"].tolist()
node_by_station = dict(zip(stations["station_id"], stations["node"]))

unique_nodes = stations["node"].unique().tolist()

# Préparer une liste de stations par node (si plusieurs stations tombent sur le même node)
stations_by_node = {}
for sid, n in node_by_station.items():
    stations_by_node.setdefault(n, []).append(sid)

rows = []

for o_node in tqdm(unique_nodes, desc="Dijkstra par node origine"):
    lengths = nx.single_source_dijkstra_path_length(G, o_node, weight="length")

    # origine(s) station(s) associée(s) à o_node
    o_station_ids = stations_by_node[o_node]

    # destinations: toutes stations (via leurs nodes)
    for d_node in unique_nodes:
        dist = lengths.get(d_node, np.nan)

        d_station_ids = stations_by_node[d_node]
        # produire toutes les combinaisons station->station correspondant aux nodes
        for oid in o_station_ids:
            for did in d_station_ids:
                rows.append({
                    "origin_id": oid,
                    "destination_id": did,
                    "distance_m": dist,   # NaN si pas de chemin (déconnexion)
                })

od = pd.DataFrame(rows)
od.to_parquet(OUT_OD, index=False)
print(f"OK -> {OUT_OD} | {len(od):,} OD")
